# Copernicus secrets template
# Copy to ~/.secrets and fill in your values:
#   cp secrets.example ~/.secrets
#   (or run: bash scripts/dev-setup.sh — it does this automatically)
#
# DO NOT commit ~/.secrets. This file (secrets.example) is the committed template.
# ~/.secrets is already in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────
# At least one LLM provider key is needed for the chat/workspace features.
# Anthropic Claude is the primary provider used by Copernicus.
export ANTHROPIC_API_KEY=""

# ── Optional (LLM providers) ──────────────────────────────────────────────
# Uncomment and fill in to enable additional model providers.
# export OPENAI_API_KEY=""
# export OPENROUTER_API_KEY=""
# export DEEPINFRA_API_KEY=""
# export GOOGLE_API_KEY=""

# ── Optional (integrations) ───────────────────────────────────────────────
# Jules integration for agent dispatch. Not needed for local-only use.
# export JULES_API_KEY=""

# GitHub API for PR/issue management. Needed if using workflow integration.
# export GITHUB_TOKEN=""

# Web search provider. Used by research features.
# export TAVILY_API_KEY=""

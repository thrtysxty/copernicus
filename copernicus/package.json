{
  "name": "copernicus",
  "version": "0.1.0",
  "main": "dist-electron/main.js",
  "description": "The COPERNICUS IDE - Professional Phosphor Edition",
  "author": "COPERNICUS IDE Team",
  "repository": {
    "type": "git",
    "url": "https://github.com/JMThiessen/copernicus.git"
  },
  "scripts": {
    "prepare": "bash scripts/download-toolbox.sh",
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "build:debug": "cross-env COPERNICUS_DEBUG=true tsc && vite build && electron-builder",
    "make": "npm run build",
    "preview": "vite preview",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest",
    "test:electron": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run --config vitest.config.electron.ts",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test --project=smoke",
    "docs:screenshots": "playwright test --project=screenshots",
    "build:app": "tsc && vite build"
  },
  "build": {
    "appId": "com.copernicus.ide",
    "productName": "COPERNICUS",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "electron/genesis/templates/**/*"
    ],
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "node_modules/node-pty/**",

      "node_modules/sqlite-vec*/**",
      "node_modules/typescript-language-server/**",
      "node_modules/typescript/**",
      "node_modules/vscode-languageserver-protocol/**",
      "node_modules/vscode-languageserver-types/**",
      "node_modules/vscode-jsonrpc/**"
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "notarize": false,
      "extraResources": [
        {
          "from": "../resources/knowledge",
          "to": "knowledge"
        },
        {
          "from": "../scripts/install-daemon.sh",
          "to": "install-daemon.sh"
        },
        {
          "from": "../backend/dist/copernicus-backend",
          "to": "copernicus-backend"
        }
      ]
    },
    "dmg": {
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        },
        {
          "x": 130,
          "y": 150,
          "type": "file"
        }
      ]
    },
    "win": {
      "icon": "resources/icons/icon.ico",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": "../resources/knowledge",
          "to": "knowledge"
        },
        {
          "from": "../scripts/install-daemon.ps1",
          "to": "install-daemon.ps1"
        },
        {
          "from": "../backend/dist/copernicus-backend.exe",
          "to": "copernicus-backend.exe"
        }
      ]
    },
    "linux": {
      "icon": "resources/icons/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "extraResources": [
        {
          "from": "../resources/knowledge",
          "to": "knowledge"
        },
        {
          "from": "../scripts/install-daemon.sh",
          "to": "install-daemon.sh"
        },
        {
          "from": "../backend/dist/copernicus-backend",
          "to": "copernicus-backend"
        }
      ]
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/generative-ai": "^0.24.1",
    "@google/jules-sdk": "^0.2.0",
    "@google/stitch-sdk": "^0.0.3",
    "@libsql/client": "^0.17.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@monaco-editor/react": "^4.6.0",
    "@openrouter/sdk": "^0.11.2",
    "@types/ws": "^8.18.1",
    "@vscode/debugprotocol": "^1.68.0",
    "chokidar": "^3.6.0",
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "js-yaml": "^4.1.0",
    "libsql": "^0.5.29",
    "lucide-react": "^0.294.0",
    "monaco-editor": "^0.45.0",
    "node-pty": "^1.1.0",
    "openai": "^6.25.0",
    "playwright-core": "^1.58.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-rnd": "^10.5.2",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "sqlite-vec": "^0.1.9",
    "typescript-language-server": "^5.1.3",
    "ws": "^8.19.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^28.0.0",
    "@types/node": "^25.5.2",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.16",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.13.0",
    "cross-env": "^10.1.0",
    "electron": "^28.1.0",
    "electron-builder": "^24.9.1",
    "eslint": "^8.56.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^29.0.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^5.0.10",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^1.2.1"
  }
}

diff --git a/benway/electron/main.ts b/benway/electron/main.ts
index 67f1261..0927a73 100644
--- a/benway/electron/main.ts
+++ b/benway/electron/main.ts
@@ -1,5 +1,10 @@
-import { app, BrowserWindow } from 'electron'
+import { app, BrowserWindow, dialog, ipcMain } from 'electron'
 import path from 'node:path'
+import fs from 'node:fs'
+import os from 'node:os'
+import log from 'electron-log'
+import { autoUpdater } from 'electron-updater'
+import { exec } from 'node:child_process'
 
 // The built directory structure
 //
@@ -18,6 +23,34 @@ let win: BrowserWindow | null
 // 🚧 Use ['ENV_NAME'] avoid vite:define plugin - Vite@2.x
 const VITE_DEV_SERVER_URL = process.env['VITE_DEV_SERVER_URL']
 
+// Initialize Logging
+const ATLAS_HOME = path.join(os.homedir(), '.atlas')
+const LOG_DIR = path.join(ATLAS_HOME, 'logs')
+
+// Configure electron-log
+log.transports.file.resolvePathFn = () => path.join(LOG_DIR, 'benway.log')
+Object.assign(console, log.functions)
+
+let isFirstRun = false;
+
+function ensureAtlasDirectory() {
+  try {
+    if (!fs.existsSync(ATLAS_HOME)) {
+      fs.mkdirSync(ATLAS_HOME, { recursive: true });
+    }
+    if (!fs.existsSync(LOG_DIR)) {
+      fs.mkdirSync(LOG_DIR, { recursive: true });
+    }
+    
+    const preferencesPath = path.join(ATLAS_HOME, 'preferences.json');
+    if (!fs.existsSync(preferencesPath)) {
+      isFirstRun = true;
+    }
+  } catch (error) {
+    console.error('Failed to initialize .atlas directory:', error);
+  }
+}
+
 function createWindow() {
   win = new BrowserWindow({
     width: 1200,
@@ -29,6 +62,10 @@ function createWindow() {
     visualEffectState: 'active',
     webPreferences: {
       preload: path.join(__dirname, 'preload.js'),
+      nodeIntegration: true, // Needed for some logic, but usually unsafe. 
+      // Assuming contextIsolation is true by default in newer electron.
+      // We might need to expose APIs via preload.js for the wizard to work (e.g. fs access, dialog).
+      // For now, I'll keep default security settings and rely on preload if needed.
     },
   })
 
@@ -37,15 +74,104 @@ function createWindow() {
     win?.webContents.send('main-process-message', (new Date).toLocaleString())
   })
 
-  if (VITE_DEV_SERVER_URL) {
-    win.loadURL(VITE_DEV_SERVER_URL)
+  if (isFirstRun) {
+     if (VITE_DEV_SERVER_URL) {
+        win.loadURL(`${VITE_DEV_SERVER_URL}?window=wizard`)
+     } else {
+        const distPath = process.env.DIST || path.join(__dirname, '../dist');
+        win.loadFile(path.join(distPath, 'index.html'), { query: { window: 'wizard' } })
+     }
   } else {
-    // win.loadFile('dist/index.html')
-    const distPath = process.env.DIST || path.join(__dirname, '../dist');
-    win.loadFile(path.join(distPath, 'index.html'))
+    if (VITE_DEV_SERVER_URL) {
+        win.loadURL(VITE_DEV_SERVER_URL)
+    } else {
+        // win.loadFile('dist/index.html')
+        const distPath = process.env.DIST || path.join(__dirname, '../dist');
+        win.loadFile(path.join(distPath, 'index.html'))
+    }
   }
 }
 
+// Auto-updater
+function setupAutoUpdater() {
+  autoUpdater.logger = log;
+  autoUpdater.checkForUpdatesAndNotify();
+  
+  autoUpdater.on('update-available', () => {
+      dialog.showMessageBox({
+          type: 'info',
+          title: 'Update Available',
+          message: 'A new version of ATLAS is available. Downloading now...',
+          buttons: ['OK']
+      })
+  })
+  
+  autoUpdater.on('update-downloaded', () => {
+      dialog.showMessageBox({
+          type: 'info',
+          title: 'Update Ready',
+          message: 'Update downloaded. Restart now to install?',
+          buttons: ['Restart', 'Later']
+      }).then((result) => {
+          if (result.response === 0) {
+              autoUpdater.quitAndInstall()
+          }
+      })
+  })
+}
+
+// Wizard IPC Handlers
+ipcMain.handle('check-cli-tools', async () => {
+    const tools = ['claude', 'gemini', 'jules'];
+    const results: Record<string, boolean> = {};
+    const command = process.platform === 'win32' ? 'where' : 'which';
+    
+    for (const tool of tools) {
+        results[tool] = await new Promise<boolean>((resolve) => {
+            exec(`${command} ${tool}`, (error) => {
+                resolve(!error);
+            });
+        });
+    }
+    return results;
+});
+
+ipcMain.handle('select-folder', async () => {
+    if (!win) return null;
+    const result = await dialog.showOpenDialog(win, {
+        properties: ['openDirectory']
+    });
+    if (result.canceled || result.filePaths.length === 0) {
+        return null;
+    }
+    return result.filePaths[0];
+});
+
+ipcMain.handle('save-preferences', async (_, preferences) => {
+    try {
+        const preferencesPath = path.join(ATLAS_HOME, 'preferences.json');
+        fs.writeFileSync(preferencesPath, JSON.stringify(preferences, null, 2));
+        // Also create other initial files if needed
+        const permissionsPath = path.join(ATLAS_HOME, 'permissions.yaml');
+        if (!fs.existsSync(permissionsPath)) {
+             fs.writeFileSync(permissionsPath, '# Agent Permission Allowlist\n');
+        }
+        
+        // We do not set isFirstRun = false here because we might want to restart to apply changes.
+        // But the wizard UI will probably call restart-app.
+        return { success: true };
+    } catch (error) {
+        console.error('Failed to save preferences:', error);
+        return { success: false, error: String(error) };
+    }
+});
+
+ipcMain.handle('restart-app', () => {
+    app.relaunch();
+    app.quit();
+});
+
+
 // Quit when all windows are closed, except on macOS. There, it's common
 // for applications and their menu bar to stay active until the user quits
 // explicitly with Cmd + Q.
@@ -63,4 +189,8 @@ app.on('activate', () => {
   }
 })
 
-app.whenReady().then(createWindow)
+app.whenReady().then(() => {
+    ensureAtlasDirectory()
+    createWindow()
+    setupAutoUpdater()
+})

diff --git a/benway/src/renderer/components/wizard/Wizard.tsx b/benway/src/renderer/components/wizard/Wizard.tsx
new file mode 100644
index 0000000..cc9f280
--- /dev/null
+++ b/benway/src/renderer/components/wizard/Wizard.tsx
@@ -0,0 +1,225 @@
+import React, { useState, useEffect } from 'react';
+import { motion, AnimatePresence } from 'framer-motion';
+import { Maximize2, Terminal, FolderOpen, DollarSign, Check, X, ArrowRight, ArrowLeft } from 'lucide-react';
+
+interface WizardProps {
+  onComplete: () => void;
+}
+
+const Wizard: React.FC<WizardProps> = ({ onComplete }) => {
+  const [step, setStep] = useState(0);
+  const [cliStatus, setCliStatus] = useState<Record<string, boolean> | null>(null);
+  const [workspacePath, setWorkspacePath] = useState('');
+  const [hourlyRate, setHourlyRate] = useState('65');
+  const [anthropicKey, setAnthropicKey] = useState('');
+  const [googleKey, setGoogleKey] = useState('');
+
+  // Step 0: Detect CLI Tools
+  useEffect(() => {
+    if (step === 0) {
+      // @ts-ignore
+      window.ipcRenderer.invoke('check-cli-tools').then((result) => {
+        setCliStatus(result);
+      });
+    }
+  }, [step]);
+
+  const handleNext = () => {
+    if (step < 3) {
+      setStep(step + 1);
+    } else {
+      handleFinish();
+    }
+  };
+
+  const handleBack = () => {
+    if (step > 0) {
+      setStep(step - 1);
+    }
+  };
+
+  const handleSelectFolder = async () => {
+    // @ts-ignore
+    const path = await window.ipcRenderer.invoke('select-folder');
+    if (path) {
+      setWorkspacePath(path);
+    }
+  };
+
+  const handleFinish = async () => {
+    const preferences = {
+      workspace: workspacePath,
+      capex: {
+        rate: parseFloat(hourlyRate),
+        currency: 'USD'
+      },
+      keys: {
+        anthropic: anthropicKey ? 'saved' : null, // Not saving actual keys to preferences as per security, but for now just mock saving status
+        google: googleKey ? 'saved' : null
+      },
+      ui: {
+        theme: 'surgical-phosphor'
+      }
+    };
+    
+    // Ideally keys should be saved to secure storage, but prompt says "stores in OS keychain". 
+    // Implementing keychain access requires native module like keytar which might be complex here.
+    // For now, we will just save preferences and assume keys are handled elsewhere or ignored for this specific story which focuses on wizard UI flow.
+    // Wait, prompt says "Sign In — prompts for Anthropic and Google AI keys, stores in OS keychain. Defer to AuthManager (Story 085)."
+    // So I don't need to implement keychain logic here, just the UI.
+
+    // @ts-ignore
+    await window.ipcRenderer.invoke('save-preferences', preferences);
+    // @ts-ignore
+    await window.ipcRenderer.invoke('restart-app');
+    onComplete();
+  };
+
+  const variants = {
+    enter: { opacity: 0, x: 20 },
+    center: { opacity: 1, x: 0 },
+    exit: { opacity: 0, x: -20 },
+  };
+
+  return (
+    <div className="flex flex-col items-center justify-center h-screen w-screen bg-benway-bg text-zinc-300 font-sans select-none p-8">
+      <div className="w-full max-w-lg bg-zinc-900/50 border border-benway-steel/30 rounded-lg p-6 backdrop-blur-md shadow-2xl">
+        <header className="mb-8 flex items-center justify-between border-b border-benway-steel/20 pb-4">
+          <div className="flex items-center gap-2">
+             <div className="w-3 h-3 bg-benway-phosphor rounded-full animate-pulse shadow-[0_0_10px_rgba(74,222,128,0.5)]"></div>
+             <h1 className="text-xl font-bold tracking-widest text-benway-phosphor uppercase">ATLAS Setup</h1>
+          </div>
+          <div className="text-xs text-zinc-500 font-mono">Step {step + 1}/4</div>
+        </header>
+
+        <div className="min-h-[300px] relative">
+            <AnimatePresence mode='wait'>
+            <motion.div
+                key={step}
+                variants={variants}
+                initial="enter"
+                animate="center"
+                exit="exit"
+                transition={{ duration: 0.2 }}
+                className="absolute w-full"
+            >
+                {step === 0 && (
+                <div className="space-y-4">
+                    <h2 className="text-lg font-semibold text-white flex items-center gap-2"><Terminal size={18} /> CLI Tool Detection</h2>
+                    <p className="text-sm text-zinc-400">Scanning your environment for required AI agents...</p>
+                    
+                    <div className="bg-black/40 rounded p-4 font-mono text-xs space-y-2 border border-benway-steel/20">
+                    {cliStatus ? Object.entries(cliStatus).map(([tool, found]) => (
+                        <div key={tool} className="flex items-center justify-between">
+                        <span className="uppercase">{tool}</span>
+                        {found ? (
+                            <span className="text-benway-phosphor flex items-center gap-1"><Check size={12} /> FOUND</span>
+                        ) : (
+                            <span className="text-red-400 flex items-center gap-1"><X size={12} /> MISSING <a href="#" className="underline ml-2 text-zinc-500">Install</a></span>
+                        )}
+                        </div>
+                    )) : (
+                        <div className="text-zinc-500 animate-pulse">Scanning...</div>
+                    )}
+                    </div>
+                </div>
+                )}
+
+                {step === 1 && (
+                <div className="space-y-4">
+                    <h2 className="text-lg font-semibold text-white flex items-center gap-2"><Maximize2 size={18} /> Sign In</h2>
+                    <p className="text-sm text-zinc-400">Configure your AI providers (stored securely in Keychain).</p>
+                    
+                    <div className="space-y-3">
+                        <div>
+                            <label className="block text-xs font-mono text-zinc-500 mb-1">ANTHROPIC_API_KEY</label>
+                            <input 
+                                type="password" 
+                                className="w-full bg-black/40 border border-benway-steel/30 rounded p-2 text-sm text-white focus:border-benway-phosphor outline-none transition-colors"
+                                placeholder="sk-ant-..."
+                                value={anthropicKey}
+                                onChange={(e) => setAnthropicKey(e.target.value)}
+                            />
+                        </div>
+                        <div>
+                            <label className="block text-xs font-mono text-zinc-500 mb-1">GOOGLE_API_KEY</label>
+                            <input 
+                                type="password" 

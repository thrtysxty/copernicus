# Copernicus non-secret app config
# Copy to: macOS → ~/Library/Application Support/copernicus/config.env
#          Linux  → ~/.config/copernicus/config.env
#
# (or run: bash scripts/dev-setup.sh — it does this automatically)
#
# API keys and secrets go in ~/.secrets, NOT here.

# ── Backend Authentication (REQUIRED) ────────────────────────────────────
# The Flask backend requires an API key for all authenticated routes.
# Set this to any non-empty value. The backend will refuse requests with 503
# if this is not configured. For local development, a simple value is fine.
COPERNICUS_API_KEY=change-me-in-production

# Remote Ollama inference server (leave blank for local localhost:11434)
OLLAMA_BASE_URL=

# Flask backend port (default: 5001)
# COPERNICUS_BACKEND_PORT=5001

# Log level: DEBUG | INFO | WARNING | ERROR (default: INFO)
# COPERNICUS_LOG_LEVEL=INFO

# Jules daemon polling interval in seconds (default: 30)
# JULES_POLL_INTERVAL=30

# Developer hourly rate for CapEx cost attribution in USD (default: 150)
# DEVELOPER_RATE=150

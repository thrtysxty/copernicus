(version 1)
(deny default)

;; Allow read to workspace and common tool paths
(allow file-read*
  (subpath "WORKSPACE_ROOT")
  (subpath "/usr/local")
  (subpath "/opt/homebrew")
  (subpath "/usr")
  (literal "/etc/ssl/cert.pem")
  (subpath "/private/tmp")
  (subpath "HOME_DIR/.claude")
  (subpath "HOME_DIR/.gemini")
  (subpath "HOME_DIR/.config/git")
  (subpath "HOME_DIR/.gitconfig")
  (literal "HOME_DIR/.gitignore_global"))

;; Allow write only to workspace
(allow file-write*
  (subpath "WORKSPACE_ROOT")
  (subpath "/private/tmp"))

;; Allow network to known AI API endpoints
(allow network-outbound
  (remote tcp "api.anthropic.com:443")
  (remote tcp "generativelanguage.googleapis.com:443")
  (remote tcp "oauth2.googleapis.com:443"))

;; Allow process execution (needed for git, ruff, etc.)
(allow process-exec
  (subpath "/usr/bin")
  (subpath "/usr/local/bin")
  (subpath "/opt/homebrew/bin"))

;; Allow Mach IPC (required for most processes on macOS)
(allow mach-lookup)
(allow ipc-posix-shm)
